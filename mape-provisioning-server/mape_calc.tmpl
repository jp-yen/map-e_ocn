# 設定ファイル・Kea リース・NDP 解決ヘルパー
# -----------------------------------------------------------------------------

def load_static_map(config_path, vlan_id):
    """map-e-static-ip.conf から VLAN ID に紐づく固定IPv4インターフェース (IPv4Interface) を返す"""
    if vlan_id is None:
        return None
    try:
        target_vlan = int(vlan_id)
    except (ValueError, TypeError):
        return None
    if not os.path.exists(config_path):
        config_path = "./map-e-static-ip.conf"
    if not os.path.exists(config_path):
        return None
    with open(config_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(",")
            if len(parts) >= 2 and parts[0].strip().isdigit() and int(parts[0].strip()) == target_vlan:
                val = parts[1].strip()
                if not val or val in ("-", "none", "null", "dynamic"):
                    return None
                try:
                    return ipaddress.IPv4Interface(val)
                except Exception as e:
                    syslog.syslog(syslog.LOG_WARNING, f"[STATIC-MAP] Invalid IPv4 prefix '{val}' for VLAN {target_vlan}: {e}")
                    return None
    return None


def load_ddns_map(config_path=None):
    """ddns.conf から MAC -> (v6_fqdn, v4_fqdn) および VLAN -> (v6_fqdn, v4_fqdn) を読み込む"""
    config_path = config_path or DDNS_CONF_PATH
    if not os.path.exists(config_path):
        config_path = "./ddns.conf"
    if not os.path.exists(config_path):
        return {}, {}

    mac_map, vlan_map = {}, {}
    try:
        with open(config_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = [p.strip() for p in line.split(",")]
                if len(parts) >= 3:
                    key, v6_fqdn, v4_fqdn = parts[0], parts[1], parts[2]
                    if key.isdigit():
                        vlan_map[int(key)] = (v6_fqdn, v4_fqdn)
                    else:
                        mac_map[_normalize_mac(key)] = (v6_fqdn, v4_fqdn)
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"[DDNS-LOAD] Error reading {config_path}: {e}")

    return mac_map, vlan_map


def _iter_active_kea_leases():
    """Kea リースファイル (kea-leases6.csv) の有効なリース行を新しい順に辞書で yield する"""
    if not os.path.exists(KEA_LEASE_FILE):
        return
    try:
        with open(KEA_LEASE_FILE, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()
        if not lines:
            return
        headers = [h.strip() for h in lines[0].split(',')]
        for line in reversed(lines[1:]):
            parts = [p.strip() for p in line.split(',')]
            if len(parts) < len(headers):
                continue
            row = dict(zip(headers, parts))
            if row.get('state', '0') not in ('0', 'active', ''):
                continue
            row['hwaddr_norm'] = _normalize_mac(row.get('hwaddr', ''))
            yield row
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"[LEASE-PARSE] Error parsing lease file: {e}")


def get_pd_prefix_from_lease(mac_str):
    """Kea リースファイルから指定 MAC アドレスに委譲された最新の IA_PD プレフィックスを取得"""
    target_mac = _normalize_mac(mac_str)
    if not target_mac:
        return None
    for row in _iter_active_kea_leases():
        if row.get('hwaddr_norm') == target_mac and row.get('lease_type', '2') in ('2', 'IA_PD', ''):
            return row.get('address')
    return None


def get_mac_from_pd_prefix(prefix_str):
    """Kea リースファイルから指定プレフィックスに合致するクライアント MAC アドレスを逆引き取得"""
    try:
        clean_target = prefix_str.split('%')[0].lower()
        target_net = ipaddress.IPv6Network(clean_target if '/' in clean_target else f"{clean_target}/56", strict=False)
    except Exception:
        return None
    for row in _iter_active_kea_leases():
        addr = row.get('address')
        if not addr:
            continue
        try:
            l_net = ipaddress.IPv6Network(f"{addr}/56", strict=False)
            if l_net.network_address == target_net.network_address and row.get('hwaddr_norm'):
                return row['hwaddr_norm']
        except Exception:
            pass
    return None


def extract_vlan_id(clean_ip, dev=None, mac=None):
    """接続インターフェース (dev)、IPv6 アドレス (clean_ip)、Kea リース、または NDP テーブルから VLAN ID を取得する"""
    if dev and '.' in dev:
        vlan_str = dev.split('.', 1)[1]
        if vlan_str.isdigit():
            return int(vlan_str)

    clean_ip_str = clean_ip.split('%')[0]

    # 1. 各接続方式のプレフィックス第3ヘクステット (${BASE_SUBNET}:<BASE+VLAN>:...) から逆算
    try:
        cand = clean_ip_str if ("::" in clean_ip_str or clean_ip_str.count(":") >= 7) else f"{clean_ip_str.rstrip(':')}::"
        exploded = ipaddress.IPv6Address(cand.split('/')[0]).exploded.split(':')
        base_len = len(_CFG['BASE_SUBNET'].split(':'))
        if len(exploded) > base_len:
            seg_hextet = exploded[base_len]
            for _, base_key, _, _, _ in _MODE_SPECS:
                base_val = str(_CFG.get(base_key, ''))
                if base_val.isdigit() and seg_hextet.startswith(base_val[0]) and seg_hextet.isdigit():
                    vlan = int(seg_hextet) - int(base_val)
                    if vlan > 0:
                        return vlan
    except Exception:
        pass

    # 2. Kea リースファイルから subnet_id -> VLAN を逆引き
    try:
        target_clean = clean_ip_str.lower()
        target_net = None
        try:
            target_net = ipaddress.IPv6Network(target_clean if '/' in target_clean else f"{target_clean}/56", strict=False)
        except Exception:
            pass
        target_mac = _normalize_mac(mac) if mac and mac != "00:00:00:00:00:00" else None

        sorted_vlans = sorted({
            int(v)
            for _, _, vlans_key, _, _ in _MODE_SPECS
            for v in _CFG.get(vlans_key, [])
        })

        for row in _iter_active_kea_leases():
            matched = False
            if target_net and row.get('address'):
                try:
                    l_net = ipaddress.IPv6Network(f"{row['address']}/56", strict=False)
                    matched = (l_net.network_address == target_net.network_address)
                except Exception:
                    pass
            if not matched and target_mac and row.get('hwaddr_norm') == target_mac:
                matched = True
            if matched and row.get('subnet_id', '').isdigit():
                sid = int(row['subnet_id'])
                if 1 <= sid <= len(sorted_vlans):
                    return sorted_vlans[sid - 1]
    except Exception:
        pass

    # 3. NDP テーブル (ip -6 neighbor) からインターフェースを検索
    try:
        res = subprocess.run(["ip", "-6", "neighbor", "show"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0:
            target_mac = _normalize_mac(mac) if mac and mac != "00:00:00:00:00:00" else None
            for line in res.stdout.splitlines():
                parts = line.split()
                if len(parts) >= 4 and 'dev' in parts:
                    nip = parts[0].split('%')[0].lower()
                    idev = parts[parts.index('dev') + 1]
                    if '.' in idev:
                        vlan_cand = idev.split('.')[-1]
                        if vlan_cand.isdigit():
                            if nip == clean_ip_str.lower():
                                return int(vlan_cand)
                            if target_mac and 'lladdr' in parts and _normalize_mac(parts[parts.index('lladdr') + 1]) == target_mac:
                                return int(vlan_cand)
    except Exception:
        pass

    return None


# -----------------------------------------------------------------------------
# DDNS (BIND9 nsupdate) 連携
# -----------------------------------------------------------------------------

def update_ddns_record(hostname, ip_str):
    """
    指定された hostname (FQDN) と ip_str (IPv4 または IPv6) に対して
    nsupdate を実行し、BIND9 の動的ゾーンを更新する。
    戻り値: (success: bool, is_changed: bool)
    """
    if not hostname or hostname == "-" or not ip_str:
        return False, False

    clean_hostname = hostname.rstrip('.')
    clean_ip = ip_str.split('%')[0].strip()

    try:
        ip_obj = ipaddress.ip_address(clean_ip)
    except ValueError:
        return False, False

    record_type = "AAAA" if ip_obj.version == 6 else "A"
    now_iso = datetime.datetime.now().astimezone().isoformat()

    script = "\n".join([
        "server 127.0.0.1",
        f"update delete {clean_hostname}. {record_type}",
        f"update add {clean_hostname}. 300 {record_type} {clean_ip}",
        f"update delete {clean_hostname}. TXT",
        f"update add {clean_hostname}. 300 TXT \"updated={now_iso}\"",
        "send",
        ""
    ])

    try:
        res = subprocess.run(["nsupdate"], input=script, text=True, capture_output=True, timeout=5)
        if res.returncode == 0:
            syslog.syslog(syslog.LOG_INFO, f"[DDNS-UPDATE] Updated {clean_hostname} -> {clean_ip} ({record_type}, updated={now_iso})")
            return True, False
        syslog.syslog(syslog.LOG_ERR, f"[DDNS-UPDATE] nsupdate failed for {clean_hostname}: {res.stderr}")
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"[DDNS-UPDATE] Error executing nsupdate: {e}")
    return False, False


def _lookup_ddns_fqdns(mac_str=None, vlan=None):
    """ddns.conf から該当する (v6_fqdn, v4_fqdn) タプルを検索する"""
    mac_map, vlan_map = load_ddns_map()
    if mac_str:
        fqdns = mac_map.get(_normalize_mac(mac_str))
        if fqdns:
            return fqdns
    if vlan is not None:
        try:
            return vlan_map.get(int(vlan))
        except (ValueError, TypeError):
            pass
    return None


def update_ddns(mac_str=None, target_v4=None, ce_ipv6=None, vlan=None):
    """ddns.conf に登録された AAAA (IPv6), A (IPv4) および TXT レコードを BIND9 へ登録"""
    if not target_v4 or not ce_ipv6:
        return False
    fqdns = _lookup_ddns_fqdns(mac_str=mac_str, vlan=vlan)
    if not fqdns:
        return False
    v6_fqdn, v4_fqdn = fqdns
    ok_v6, _ = update_ddns_record(v6_fqdn, ce_ipv6) if v6_fqdn and v6_fqdn != "-" else (False, False)
    ok_v4, _ = update_ddns_record(v4_fqdn, target_v4) if v4_fqdn and v4_fqdn != "-" else (False, False)
    return ok_v6 or ok_v4


def get_ddns_hostname(mac_str=None, target_v4=None, vlan=None):
    """ddns.conf から該当するホスト名 (FQDN) を取得する（未登録なら 'ce-{target_v4}.map.ocn.ad.jp'）"""
    default_hostname = f"ce-{target_v4}.map.ocn.ad.jp" if target_v4 else "ce.map.ocn.ad.jp"
    try:
        fqdns = _lookup_ddns_fqdns(mac_str=mac_str, vlan=vlan)
        if fqdns:
            v6_fqdn, v4_fqdn = fqdns
            if v4_fqdn and v4_fqdn != "-":
                return v4_fqdn
            if v6_fqdn and v6_fqdn != "-":
                return v6_fqdn
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"[DDNS-HOSTNAME] Error resolving hostname: {e}")
    return default_hostname


def get_ddns_hostname_for_ip(clean_ip, target_v4=None, dev=None):
    """接続元 IP / プレフィックスから MAC および VLAN を復元し、FQDN を決定する"""
    clean_ip_str = clean_ip.split('%')[0]
    mac = extract_mac_from_eui64(clean_ip_str) or get_mac_from_pd_prefix(clean_ip_str)
    vlan_id = extract_vlan_id(clean_ip_str, dev=dev, mac=mac)
    return get_ddns_hostname(mac_str=mac, target_v4=target_v4, vlan=vlan_id)


# -----------------------------------------------------------------------------
# MAC / セグメント / MAP-E パラメータ計算
# -----------------------------------------------------------------------------

def extract_mac_from_eui64(ipv6_addr_str):
    """IPv6アドレスの下位64bitが Modified EUI-64 形式 (ff:fe) であれば MAC アドレスを逆算して返す"""
    try:
        exploded = ipaddress.IPv6Address(ipv6_addr_str.split('%')[0]).exploded.split(':')
        iid_hex = ''.join(exploded[4:8])
        if iid_hex[6:10] != 'fffe':
            return None
        mac_hex = iid_hex[0:6] + iid_hex[10:16]
        first_byte = int(mac_hex[0:2], 16) ^ 0x02
        rest_bytes = [mac_hex[i:i + 2] for i in range(2, 12, 2)]
        return ":".join([f"{first_byte:02x}"] + rest_bytes)
    except Exception:
        return None


def get_mac_from_ndp(clean_ip=None, dev=None):
    """カーネルの IPv6 近隣探索テーブル (ip -6 neighbor show) から CE の L2 MAC アドレスを取得する"""
    try:
        res = subprocess.run(["ip", "-6", "neighbor", "show"], capture_output=True, text=True, timeout=2)
        if res.returncode != 0:
            return None
        target_ip = clean_ip.split('%')[0].split('/')[0].lower() if clean_ip else None
        fallback_mac = None
        for line in res.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 5 and "lladdr" in parts and "dev" in parts:
                nip = parts[0].split('%')[0].lower()
                dev_idx = parts.index("dev") + 1
                ll_idx = parts.index("lladdr") + 1
                if dev_idx < len(parts) and ll_idx < len(parts):
                    ndev = parts[dev_idx]
                    nmac = _normalize_mac(parts[ll_idx])
                    if target_ip and nip == target_ip:
                        return nmac
                    if dev and ndev == dev and not fallback_mac:
                        fallback_mac = nmac
        return fallback_mac
    except Exception:
        return None


def classify_segment(prefix_str, cfg, dev=None):
    """
    受信したIPv6プレフィックス(アドレス)またはデバイス名から接続方式 (①〜⑥) を判定する:
      slaac_dyn / pd_dyn / slaac_fix / pd_fix / hgw_dyn / hgw_fix
    """
    clean = prefix_str.split('%')[0]

    if (clean.lower().startswith("fe80") or clean == "::") and dev:
        parts = dev.split('.')
        if len(parts) == 2 and parts[1].isdigit():
            vlan = int(parts[1])
            for seg, _, vlans_key, _, _ in _MODE_SPECS:
                if vlan in cfg.get(vlans_key, []):
                    return seg
        return None

    try:
        exploded = ipaddress.IPv6Address(clean).exploded.split(':')
    except ValueError:
        return None

    base_len = len(cfg['BASE_SUBNET'].split(':'))
    if len(exploded) <= base_len:
        return None
    seg_hextet = exploded[base_len]

    # 1. MAPE_*_PREFIX との完全一致チェック
    for seg, _, _, prefix_key, _ in _MODE_SPECS:
        if prefix_key and cfg.get(prefix_key):
            pfx_hextet = ipaddress.IPv6Address(f"{cfg[prefix_key].rstrip(':')}::").exploded.split(':')[base_len]
            if seg_hextet == pfx_hextet:
                return seg

    # 2. 各方式のベース値先頭桁 (1xxx..6xxx) によるチェック
    for seg, base_key, _, _, _ in _MODE_SPECS:
        if cfg.get(base_key):
            lead = ipaddress.IPv6Address(f"{cfg['BASE_SUBNET']}:{cfg[base_key]}::").exploded.split(':')[base_len][0]
            if seg_hextet[0] == lead:
                return seg

    return None


def convert_to_data_ipv6(base_prefix_str, target_v4_str, target_psid=0, is_slaac=False):
    """
    RFC 7597 Section 6.2 に準拠した CE IPv6 アドレスの自動合成
    Interface ID 構造: 00 + IPv4(32bit) + PSID(16bit) + 0000(16bit)
    """
    try:
        clean_prefix = base_prefix_str.split('%')[0]
        if is_slaac:
            prefix_part = ipaddress.IPv6Address(clean_prefix).exploded.split(':')[:4]
        else:
            if not clean_prefix.endswith("::") and ":" in clean_prefix and len(clean_prefix.split(':')) <= 4:
                clean_prefix += "::"
            net6 = ipaddress.IPv6Network(f"{clean_prefix}/56", strict=False)
            prefix_part = net6.network_address.exploded.split(':')[:4]

        v4_octets = [int(x) for x in target_v4_str.split('.')]
        psid_val = int(target_psid) if target_psid else 0
        psid_high = (psid_val >> 8) & 0xff
        psid_low = psid_val & 0xff

        block4 = f"00{v4_octets[0]:02x}"
        block5 = f"{v4_octets[1]:02x}{v4_octets[2]:02x}"
        block6 = f"{v4_octets[3]:02x}{psid_high:02x}"
        block7 = f"{psid_low:02x}00"

        data_ipv6 = f"{':'.join(prefix_part)}:{block4}:{block5}:{block6}:{block7}"
        return ipaddress.IPv6Address(data_ipv6).compressed
    except Exception as e:
        raise ValueError(f"Failed to calculate data IPv6: {e}")


def _extract_mac_and_segment(clean_ip, dev):
    """
    入力 IPv6 アドレス/プレフィックスから MAC アドレス（可能な場合）を復元し、
    接続方式 (segment) とグローバルプレフィックス (clean_ip) を確定する。
    """
    mac = extract_mac_from_eui64(clean_ip) or get_mac_from_ndp(clean_ip, dev) or "00:00:00:00:00:00"

    if clean_ip.lower().startswith("fe80") or clean_ip == "::":
        segment = classify_segment(clean_ip, _CFG, dev)
        if segment is None:
            raise ValueError(f"Cannot classify segment for link-local prefix: {clean_ip} (dev: {dev})")

        _, base_key, _, _, is_dyn = _MODE_BY_NAME[segment]
        pd_prefix = get_pd_prefix_from_lease(mac) if (segment not in ('slaac_dyn', 'slaac_fix') and mac != "00:00:00:00:00:00") else None
        if pd_prefix:
            clean_ip = pd_prefix
        elif dev and '.' in dev:
            vlan = int(dev.split('.')[1])
            prefix_hextet = int(_CFG[base_key]) + vlan
            if is_dyn:
                psid = ((vlan - 1) % 63) + 1
                clean_ip = f"{_CFG['BASE_SUBNET']}:{prefix_hextet}:{psid:02x}00::"
            else:
                clean_ip = f"{_CFG['BASE_SUBNET']}:{prefix_hextet}::"
        else:
            raise ValueError(f"Device name or DHCPv6-PD lease required for link-local setup ({segment})")
    else:
        segment = classify_segment(clean_ip, _CFG, dev)
        if segment is None:
            raise ValueError(f"Cannot classify segment for prefix: {clean_ip}")

    return mac, clean_ip, segment


def _is_slaac_mode(clean_ip, segment):
    """対象セグメントおよびプレフィックスが SLAAC (RA /64) 方式か判定する"""
    if segment in ('slaac_dyn', 'slaac_fix'):
        return True
    if segment in ('hgw_dyn', 'hgw_fix'):
        try:
            if '/' in clean_ip:
                return int(clean_ip.split('/')[1]) >= 64
            cand = clean_ip if ("::" in clean_ip or clean_ip.count(":") >= 7) else f"{clean_ip}::"
            exploded = ipaddress.IPv6Address(cand.split('/')[0]).exploded.split(':')
            base_len = len(_CFG['BASE_SUBNET'].split(':'))
            fourth_hextet = exploded[base_len + 1] if len(exploded) > base_len + 1 else "0000"
            return (int(fourth_hextet, 16) & 0x00ff) < 0x0010
        except Exception:
            return True
    return False


def _compute_target_v4(mac, clean_ip, segment, dev=None):
    """
    接続方式に応じて割り当て IPv4 アドレスを決定する。
    - 固定セグメント(slaac_fix, pd_fix, hgw_fix): VLAN ID に紐づく静的マップを参照（未登録は PermissionError）。
    - 動的セグメント(slaac_dyn, pd_dyn, hgw_dyn): BMR Rule IPv4 /20 + EA-bits 上位12bit から算出。
    """
    is_slaac = _is_slaac_mode(clean_ip, segment)
    vlan_id = extract_vlan_id(clean_ip, dev=dev, mac=mac)

    if segment in ('slaac_fix', 'pd_fix', 'hgw_fix'):
        if vlan_id is not None:
            static_iface = load_static_map(STATIC_IP_CONF_PATH, vlan_id)
            if static_iface:
                net = static_iface.network
                return net.network_address, net.prefixlen, is_slaac, net.network_address
        raise PermissionError(f"Unregistered VLAN ({vlan_id}) cannot connect on fixed segment ({segment})")

    pool_octets = _get_ipv4_pool_network().network_address.exploded.split('.')
    vlan_id = vlan_id or 1

    # BMR Rule IPv4 /20 (gen_kea_configs / validate_option94 と同一)
    v4_sub_idx = (vlan_id - 1) % 16
    octet2 = (v4_sub_idx * 16) & 0xf0
    rule_v4_net = ipaddress.IPv4Network(f"{pool_octets[0]}.{pool_octets[1]}.{octet2}.0/20")

    # CE IPv6 から EA-bits (18bit: ビット 38〜55) を抽出
    cand = clean_ip if ("::" in clean_ip or clean_ip.count(":") >= 7) else f"{clean_ip}::"
    v6_net = ipaddress.IPv6Network(f"{cand}/64" if is_slaac else f"{cand}/56", strict=False)
    ea_bits = (int(v6_net.network_address) >> 72) & 0x3ffff
    v4_suffix = (ea_bits >> 6) & 0xfff

    target_v4 = ipaddress.IPv4Address(int(rule_v4_net.network_address) | v4_suffix)
    return target_v4, 32, is_slaac


def _compute_psid(mac, clean_ip, segment, dev=None):
    """動的接続は EA-bits 下位6bit または VLAN ID から PSID (1..63) を算出し、固定接続は 0 を返す"""
    if segment in ('slaac_dyn', 'pd_dyn', 'hgw_dyn'):
        cand = clean_ip if ("::" in clean_ip or clean_ip.count(":") >= 7) else f"{clean_ip}::"
        try:
            v6_net = ipaddress.IPv6Network(f"{cand}/64" if "slaac" in segment else f"{cand}/56", strict=False)
            derived_psid = (int(v6_net.network_address) >> 72) & 0x3f
            if 1 <= derived_psid <= 63:
                return derived_psid
        except Exception:
            pass
        vlan = extract_vlan_id(clean_ip, dev=dev, mac=mac)
        if vlan and int(vlan) > 0:
            return ((int(vlan) - 1) % 63) + 1
        return 1
    return 0


class MapEParams(tuple):
    """4要素タプル (v4, ce_v6, seg, psid) 互換で v4_prefixlen, mac 属性を保持する戻り値クラス"""
    def __new__(cls, v4, ce_v6, seg, psid, v4_len=32, mac=None):
        return super().__new__(cls, (v4, ce_v6, seg, psid))

    def __init__(self, v4, ce_v6, seg, psid, v4_len=32, mac=None):
        self.v4_prefixlen = v4_len
        self.mac = mac


def calc_map_e_params(prefix_str, dev=None):
    """
    ①〜⑥ いずれの接続方式かを判定し、対応するIPv4アドレス・CEデータ通信IPv6アドレス・PSIDを算出する。
    戻り値: MapEParams(target_ipv4_str, ce_ipv6_str, segment_str, target_psid_int)
    """
    clean_ip = prefix_str.split('%')[0]
    mac, clean_ip, segment = _extract_mac_and_segment(clean_ip, dev)
    if (not mac or mac == "00:00:00:00:00:00") and segment in ('pd_dyn', 'pd_fix', 'hgw_dyn', 'hgw_fix'):
        mac = get_mac_from_pd_prefix(clean_ip) or mac

    res_v4 = _compute_target_v4(mac, clean_ip, segment, dev=dev)
    target_v4, v4_prefixlen, is_slaac = res_v4[0], res_v4[1], res_v4[2]
    ce_host_ip = res_v4[3] if len(res_v4) > 3 else target_v4

    target_psid = _compute_psid(mac, clean_ip, segment, dev=dev)
    ce_ipv6 = convert_to_data_ipv6(clean_ip, str(ce_host_ip), target_psid=0, is_slaac=is_slaac)

    vlan_id = extract_vlan_id(clean_ip, dev=dev, mac=mac)
    update_ddns(mac_str=mac, target_v4=str(target_v4), ce_ipv6=ce_ipv6, vlan=vlan_id)

    return MapEParams(str(target_v4), ce_ipv6, segment, target_psid, v4_prefixlen, mac=mac)
