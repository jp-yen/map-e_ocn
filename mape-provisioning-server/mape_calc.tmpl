    ('hgw_fix',   'HGW_FIX_BR_BASE',     'HGW_FIX_VLANS',   'MAPE_HGW_FIX_PREFIX', False),
)
_MODE_BY_NAME = {m[0]: m for m in _MODE_SPECS}


def _normalize_mac(mac_str):
    """MACアドレス文字列を小文字コロン区切り (aa:bb:cc:dd:ee:ff) に正規化する"""
    if not mac_str:
        return None
    m = mac_str.strip().lower().replace("-", ":")
    if ":" not in m and len(m) == 12:
        m = ":".join(m[i:i + 2] for i in range(0, 12, 2))
    return m


def _get_ipv4_pool_network():
    """BR_IPV4_POOL / BR_IPV4_MASK から IPv4Network オブジェクトを返す"""
    if '/' in BR_IPV4_POOL:
        return ipaddress.IPv4Network(BR_IPV4_POOL, strict=False)
    mask = int(BR_IPV4_MASK) if BR_IPV4_MASK else 16
    return ipaddress.IPv4Network(f"{BR_IPV4_POOL}/{mask}", strict=False)


def get_tunnel_dev_name(ipv4_str):
    """システム全体で共有する ip6tnl (collect metadata) トンネルデバイス名を返す"""
    return "mpe-common"


# -----------------------------------------------------------------------------
# 実ルーティング設定 (ip link / ip route / nftables 操作)
# -----------------------------------------------------------------------------

MAPE_PBR_TABLE_BASE = 300
MAPE_FWMARK_BASE = 0x100
_NFT_PBR_INITIALIZED = False


def ensure_mape_pbr_and_nft():
    """
    BR側での1 IPv4複数CE共有（ポート多重化）を実現するため、
    nftablesによるPSID判定・fwmark付与ルールと、ポリシーベースルーティング (ip rule)
    のルックアップテーブル (301..363) を整備する。
    """
    global _NFT_PBR_INITIALIZED
    if _NFT_PBR_INITIALIZED:
        return

    try:
        r_rules = subprocess.run(["ip", "rule", "show"], capture_output=True, text=True)
        rules_text = r_rules.stdout if r_rules.returncode == 0 else ""
        for psid in range(1, 64):
            tbl = MAPE_PBR_TABLE_BASE + psid
            mark_hex = hex(MAPE_FWMARK_BASE | psid)
            if f"fwmark {mark_hex}" not in rules_text and f"lookup {tbl}" not in rules_text:
                subprocess.run(
                    ["ip", "rule", "add", "pref", str(tbl), "fwmark", str(mark_hex), "lookup", str(tbl)],
                    check=False, capture_output=True
                )
    except Exception as e:
        syslog.syslog(syslog.LOG_WARNING, f"[PBR-INIT] Failed to ensure ip rules: {e}")

    try:
        chk_nft = subprocess.run(["nft", "list", "table", "ip", "mape_ap"], capture_output=True, text=True)
        if chk_nft.returncode != 0:
            pool_cidr = str(_get_ipv4_pool_network())
            nft_script = f"""
table ip mape_ap {{
    chain classify_psid {{
        meta mark != 0 return
        meta l4proto {{ tcp, udp }} th dport >= 1024 th dport & 0x03f0 != 0 meta mark set 0x100 | ((th dport & 0x03f0) >> 4) return
        icmp type {{ echo-request, echo-reply }} icmp id >= 1024 icmp id & 0x03f0 != 0 meta mark set 0x100 | ((icmp id & 0x03f0) >> 4) return
    }}
    chain prerouting {{
        type filter hook prerouting priority mangle; policy accept;
        ip daddr {pool_cidr} jump classify_psid
    }}
    chain output {{
        type route hook output priority mangle; policy accept;
        ip daddr {pool_cidr} jump classify_psid
    }}
}}
"""
            nft_res = subprocess.run(["nft", "-f", "-"], input=nft_script, text=True, capture_output=True)
            if nft_res.returncode == 0:
                syslog.syslog(syslog.LOG_INFO, "[NFT-INIT] Configured nftables table ip mape_ap for A+P demux")
            else:
                syslog.syslog(syslog.LOG_WARNING, f"[NFT-INIT] nftables setup warning: {nft_res.stderr.strip()}")
        _NFT_PBR_INITIALIZED = True
    except Exception as e:
        syslog.syslog(syslog.LOG_WARNING, f"[NFT-INIT] Error setting up nftables: {e}")


def ensure_tunnel_dev(tunnel_dev):
    """tunnel_dev という名前の ip6tnl external トンネルデバイスがなければ作成して MTU 1460 / UP にする"""
    check = subprocess.run(["ip", "link", "show", tunnel_dev], capture_output=True, text=True)
    if check.returncode == 0:
        subprocess.run(["ip", "link", "set", tunnel_dev, "mtu", "1460", "up"], check=False, capture_output=True)
        return True

    try:
        subprocess.run(
            ["ip", "link", "add", tunnel_dev, "type", "ip6tnl", "mode", "any", "external"],
            check=True, capture_output=True, text=True
        )
        subprocess.run(["ip", "link", "set", tunnel_dev, "mtu", "1460", "up"], check=True, capture_output=True, text=True)
        syslog.syslog(syslog.LOG_INFO, f"[TUNNEL-CREATE] Created tunnel device: {tunnel_dev} (mtu 1460)")
        return True
    except subprocess.CalledProcessError as e:
        syslog.syslog(syslog.LOG_ERR, f"[TUNNEL-CREATE] Failed to create tunnel device {tunnel_dev}: {e.stderr}")
        return False


def setup_tunnel_route(target_ipv4, ce_ipv6, br_ipv6, prefixlen=32, mac=None, psid=0):
    """
    target_ipv4/prefixlen 宛のトラフィックがトンネルデバイス経由で CE(ce_ipv6) へ届くよう
    ルート投入と近隣キャッシュ整備を行う。psid が 1..63 の場合は PBR テーブル (300 + psid) にも登録する。
    """
    dst_prefix = f"{target_ipv4}/{prefixlen}"
    tunnel_dev = get_tunnel_dev_name(target_ipv4)

    if not ensure_tunnel_dev(tunnel_dev):
        return False

    try:
        routing_dst_ipv6 = ipaddress.IPv6Address(ce_ipv6).compressed
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"[ROUTE-ADD] Failed to parse ce_ipv6 {ce_ipv6}: {e}")
        return False

    current_dev = None
    try:
        r_get = subprocess.run(["ip", "-6", "route", "get", routing_dst_ipv6], capture_output=True, text=True)
        if r_get.returncode == 0:
            m = re.search(r"\bdev\s+([^\s]+)", r_get.stdout)
            if m:
                current_dev = m.group(1)
    except Exception:
        pass

    if (not mac or mac == "00:00:00:00:00:00") and ce_ipv6:
        mac = extract_mac_from_eui64(ce_ipv6)
    if (not mac or mac == "00:00:00:00:00:00") and current_dev:
        mac = get_mac_from_ndp(routing_dst_ipv6, current_dev)

    if mac and current_dev and mac != "00:00:00:00:00:00":
        cleanup_stale_neighbor_and_routes(mac, current_dev, current_dst_ipv6=routing_dst_ipv6)

    try:
        if int(prefixlen) != 32:
            subprocess.run(["ip", "route", "del", f"{target_ipv4}/32"], check=False, capture_output=True)

        existing = subprocess.run(
            ["ip", "route", "show", dst_prefix],
            capture_output=True, text=True
        ).stdout.strip()

        is_update = bool(existing)
        keep_proto = ["proto", "250"] if re.search(r"\bproto\s+250\b", existing) else []

        psid_int = int(psid) if psid else 0
        if 1 <= psid_int <= 63:
            ensure_mape_pbr_and_nft()
            pbr_table = MAPE_PBR_TABLE_BASE + psid_int
            subprocess.run([
                "ip", "route", "replace", dst_prefix,
                "src", BR_IPV4_ADDR, "dev", tunnel_dev, *keep_proto,
                "table", str(pbr_table),
                "encap", "ip6", "src", br_ipv6, "dst", routing_dst_ipv6
            ], check=False, capture_output=True)
            syslog.syslog(syslog.LOG_INFO, f"[PBR-ROUTE] Injected route {dst_prefix} -> table {pbr_table} (PSID={psid_int})")

        subprocess.run([
            "ip", "route", "replace", dst_prefix,
            "src", BR_IPV4_ADDR, "dev", tunnel_dev, *keep_proto,
            "encap", "ip6", "src", br_ipv6, "dst", routing_dst_ipv6
        ], check=True, capture_output=True, text=True)

        if mac and current_dev and mac != "00:00:00:00:00:00":
            try:
                subprocess.run([
                    "ip", "-6", "neigh", "replace", routing_dst_ipv6,
                    "lladdr", mac, "dev", current_dev, "nud", "permanent"
                ], check=False, capture_output=True)
                syslog.syslog(syslog.LOG_INFO, f"[NEIGH-STATIC] Registered permanent neigh {routing_dst_ipv6} -> {mac} on {current_dev}")
            except Exception as e:
                syslog.syslog(syslog.LOG_WARNING, f"[NEIGH-STATIC] Failed to add neigh: {e}")

        event_type = "TUNNEL_UPDATE" if is_update else "TUNNEL_CREATE"
        syslog.syslog(syslog.LOG_INFO,
                       f"[{event_type}] {dst_prefix} -> dev {tunnel_dev} (encap ip6 dst {routing_dst_ipv6}, psid={psid_int})")
        _write_tunnel_event(event_type, str(dst_prefix), routing_dst_ipv6)
        return True
    except subprocess.CalledProcessError as e:
        syslog.syslog(syslog.LOG_ERR, f"[ROUTE-ADD] Failed to set route for {dst_prefix}: {e.stderr}")
        return False


def _write_tunnel_event(event_type, ipv4_str, ce_ipv6_str):
    """トンネル作成・更新イベントを TUNNEL_EVENT_LOG へ追記する"""
    try:
        now_iso = datetime.datetime.now().astimezone().isoformat(timespec='seconds')
        with open(TUNNEL_EVENT_LOG, "a", encoding="utf-8") as f:
            f.write(f"{event_type}\t{now_iso}\t{ipv4_str}\t{ce_ipv6_str}\n")
    except Exception as e:
        syslog.syslog(syslog.LOG_WARNING, f"[TUNNEL-EVENT] Failed to write event log: {e}")


def cleanup_stale_neighbor_and_routes(mac, current_dev, current_dst_ipv6=None):
    """
    対象 MAC アドレスについて、current_dev 以外の旧インターフェースに残存している
    NDP キャッシュエントリ、旧インターフェース経由の IPv6 経路、および旧 mpe-common 経路を削除する。
    """
    if not mac or mac == "00:00:00:00:00:00" or not current_dev:
        return
    mac_norm = _normalize_mac(mac)

    try:
        res = subprocess.run(["ip", "-6", "neigh", "show"], capture_output=True, text=True)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                parts = line.strip().split()
                if len(parts) >= 5 and "lladdr" in parts and "dev" in parts:
                    dev_idx = parts.index("dev") + 1
                    lladdr_idx = parts.index("lladdr") + 1
                    if dev_idx < len(parts) and lladdr_idx < len(parts):
                        entry_ip = parts[0]
                        entry_dev = parts[dev_idx]
                        entry_mac = _normalize_mac(parts[lladdr_idx])
                        if entry_mac == mac_norm and entry_dev != current_dev:
                            r_via = subprocess.run(["ip", "-6", "route", "show", "via", entry_ip], capture_output=True, text=True)
                            if r_via.returncode == 0:
                                for r_line in r_via.stdout.splitlines():
                                    r_parts = r_line.strip().split()
                                    if r_parts:
                                        subprocess.run(["ip", "-6", "route", "del", r_parts[0], "via", entry_ip, "dev", entry_dev],
                                                       check=False, capture_output=True)
                            subprocess.run(["ip", "-6", "neigh", "del", entry_ip, "dev", entry_dev],
                                           check=False, capture_output=True)
                            syslog.syslog(syslog.LOG_INFO,
                                          f"[NEIGH-CLEANUP] Deleted stale neigh {entry_ip} dev {entry_dev} for MAC {mac}")
    except Exception as e:
        syslog.syslog(syslog.LOG_WARNING, f"[NEIGH-CLEANUP] Failed to cleanup neigh for MAC {mac}: {e}")

    if current_dst_ipv6:
        try:
            curr_v6_norm = ipaddress.IPv6Address(current_dst_ipv6).compressed
            res_t = subprocess.run(["ip", "route", "show", "dev", "mpe-common"], capture_output=True, text=True)
            if res_t.returncode == 0:
                for t_line in res_t.stdout.splitlines():
                    m = re.search(r"^([^\s]+)\s+encap ip6.*?dst\s+([0-9a-fA-F:]+)", t_line.strip())
                    if m:
                        old_pfx, old_dst = m.group(1), m.group(2)
                        try:
                            old_dst_norm = ipaddress.IPv6Address(old_dst).compressed
                        except Exception:
                            old_dst_norm = old_dst
                        if old_dst_norm != curr_v6_norm and extract_mac_from_eui64(old_dst_norm) == mac_norm:
                            subprocess.run(["ip", "route", "del", old_pfx, "dev", "mpe-common"], check=False, capture_output=True)
                            syslog.syslog(syslog.LOG_INFO, f"[TUNNEL-CLEANUP] Deleted stale mpe-common route {old_pfx} (dst {old_dst}) for MAC {mac}")
        except Exception as e:
            syslog.syslog(syslog.LOG_WARNING, f"[TUNNEL-CLEANUP] Failed to cleanup mpe-common routes for MAC {mac}: {e}")


cleanup_stale_neighbor_entries = cleanup_stale_neighbor_and_routes


