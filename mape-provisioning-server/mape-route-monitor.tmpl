#!/usr/bin/env python3
import subprocess
import syslog
import sys

# 共通ライブラリのインポート
sys.path.append("/usr/local/bin")
try:
    import mape_calc
except ImportError as e:
    syslog.openlog(ident='mape-monitor-init', facility=syslog.LOG_USER)
    syslog.syslog(syslog.LOG_ERR, f"Failed to import common library: {e}")
    syslog.closelog()
    sys.exit(1)

# 設定項目
BR_IPV6 = "${BR_IPV6}"

syslog.openlog(ident='mape-monitor', facility=syslog.LOG_USER)
syslog.syslog(syslog.LOG_INFO, "Starting MAP-E Dynamic Route Monitor (Stateless Mode)...")

def main():
    # 検出(ip monitor neigh の監視)のみをここで行い、実際の `ip link` /
    # `ip route` 操作はすべて mape_calc 側の関数に委譲する。
    cmd = ["ip", "monitor", "neigh"]
    process = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)

    for line in iter(process.stdout.readline, ''):
        line_upper = line.upper()

        if any(status in line_upper for status in ["REACHABLE", "STALE", "DELAY"]):
            parts = line.split()
            try:
                ce_ipv6 = parts[0]
                dev_idx = parts.index("dev")
                current_dev = parts[dev_idx + 1]
            except (ValueError, IndexError):
                continue

            if not ce_ipv6.lower().startswith("fe80"):
                continue

            # 1. 接続先が移動（または複数）している可能性があるため、古いルートを掃除
            mape_calc.cleanup_stale_neighbor_routes(ce_ipv6, current_dev)

            # 2. 新しい経路を追加（または再適用）
            try:
                target_ipv4, ce_ipv6_global, _, _ = mape_calc.calc_map_e_params(ce_ipv6, current_dev)
                mape_calc.setup_tunnel_route(target_ipv4, ce_ipv6_global, BR_IPV6)
                syslog.syslog(syslog.LOG_INFO, f"[ROUTE-UPDATE] CE: {ce_ipv6} -> {target_ipv4} via {current_dev}")
            except Exception as e:
                syslog.syslog(syslog.LOG_ERR, f"Error processing route: {e}")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        syslog.closelog()
