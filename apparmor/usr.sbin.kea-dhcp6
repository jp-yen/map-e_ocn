abi <abi/3.0>,
# cat > /etc/apparmor.d/usr.sbin.kea-dhcp6

include <tunables/global>

profile kea-dhcp6 /usr/sbin/kea-dhcp6 {
  include <abstractions/base>
  include <abstractions/nameservice>

  # ⬇️【重要】ここに以下の4行（必要な特権）を追加します
  capability dac_override,
  capability dac_read_search,
  capability setuid,
  capability setgid,

  # for MySQL access, localhost
  include <abstractions/mysql>
  include <abstractions/openssl>

  network inet dgram,
  network inet stream,
  network netlink raw,
  network packet raw,

  /etc/gss/mech.d/ r,
  /etc/gss/mech.d/* r,

  /etc/kea/ r,
  /etc/kea/** r,

  # 🌟 【追加】ホームディレクトリ配下の任意の kea-dhcp6.conf の読み込みを許可
  /home/**/kea-dhcp6/kea-dhcp6.conf r,

  /usr/sbin/kea-dhcp6 mr,
  /usr/sbin/kea-lfc Px,

  owner /run/kea/kea-dhcp6.kea-dhcp6.pid rw,
  owner /run/lock/kea/logger_lockfile rwk,

  # Control sockets
  # Before LP: #1863100, these were in /tmp. For compatibility, let's keep both
  # locations
  owner /run/kea/kea-dhcp6-ctrl.sock rwk,
  owner /run/kea/kea-dhcp6-ctrl.sock.lock rwk,
  owner /run/kea/kea-dhcp6-ctrl.socket rwk,
  owner /run/kea/kea-dhcp6-ctrl.socket.lock rwk,

  owner /var/lib/kea/kea-dhcp6-serverid rw,

  # this includes .completed, .output, .pid, .[0-9]
  owner /var/lib/kea/kea-leases6.csv* rw,

  owner /var/log/kea/kea-dhcp6.log rw,
  owner /var/log/kea/kea-dhcp6.log.[0-9]* rw,
  owner /var/log/kea/kea-dhcp6.log.lock rwk,

  /run/kea/kea-dhcp6-ctrl.socket rwk,
  /run/kea/kea-dhcp6-ctrl.socket.lock rwk,

  # 💡 修正ポイント①: ローカルのサブプロファイルへの遷移（Cx と コロンを指定）
  /usr/local/bin/kea-map-e-hook Cx -> kea_mape_hook,

  # Site-specific additions and overrides. See local/README for details.
  #include <local/usr.sbin.kea-dhcp6>

  # =========================================================
  # 💡 修正ポイント②: サブプロファイル（Hat）の内部をPython用に最適化
  # =========================================================
  profile kea_mape_hook flags=(complain) {
    include <abstractions/base>

    # Python インタプリタと標準ライブラリの読み込み許可
    /usr/bin/python3* ix,
    /usr/lib/python3*/** r,
    /usr/lib/python3*/dist-packages/ r,
    /usr/lib/python3*/dist-packages/** r,
    /usr/local/lib/python3*/** r,

    # スクリプト本体の読み取り許可
    /usr/local/bin/kea-map-e-hook r,

    # 外部コマンド実行（ルート追加用）
    /usr/bin/sudo    ix,
    /usr/sbin/ip     ix,

    # Python スクリプトが出力するログ・デバッグファイル
    /var/log/kea/kea-hook.log rw,
    /tmp/kea-env-debug.log rw,
    
    # syslog (syslogモジュール用)
    /dev/log w,

    # 親から引き継がれるファイル記述子の許可
    /run/lock/kea/logger_lockfile rw,
    /run/kea/kea-dhcp6-ctrl.socket.lock r,
    /var/lib/kea/kea-leases6.csv rw,
    /dev/null rw,
  }

  # Site-specific additions and overrides. See local/README for details.
  #include <local/usr.sbin.kea-dhcp6>
}

