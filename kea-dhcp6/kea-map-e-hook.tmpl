#!/bin/sh
# =============================================================================
# Kea DHCPv6 External Hook Script for MAP-E Router Routing
# (kea-dhcp6/kea-map-e-hook.tmpl -> gen_config.pl hook -> /etc/kea/kea-map-e-hook)
# =============================================================================
LOG_TAG="kea-map-e-hook"

log_message() {
    logger -t "${LOG_TAG}" -p local0.info "$1" 2>/dev/null || true
    echo "[${LOG_TAG}] $1" >&2
}

add_route() {
    local prefix="$1" gateway="$2" iface="$3" err_msg
    log_message "DEBUG: Attempting to add route. Prefix: ${prefix}, Gateway: ${gateway}, Iface: ${iface}"
    
    if [ -z "${gateway}" ]; then
        log_message "ERROR: Gateway address is empty. Cannot add route."
        return 1
    fi

    local ip_cmd="ip"
    if ! command -v ip >/dev/null 2>&1 && [ -x /sbin/ip ]; then
        ip_cmd="/sbin/ip"
    fi

    err_msg=$("${ip_cmd}" -6 route replace "${prefix}" via "${gateway}" dev "${iface}" proto static 2>&1)
    if [ $? -ne 0 ]; then
        log_message "Failed to add route ${prefix} via ${gateway} dev ${iface}: ${err_msg}"
    else
        log_message "Added route ${prefix} via ${gateway} dev ${iface}"
    fi
}

del_route() {
    local prefix="$1" err_msg
    local ip_cmd="ip"
    if ! command -v ip >/dev/null 2>&1 && [ -x /sbin/ip ]; then
        ip_cmd="/sbin/ip"
    fi

    err_msg=$("${ip_cmd}" -6 route del "${prefix}" proto static 2>&1)
    if [ $? -ne 0 ]; then
        log_message "Failed to delete route ${prefix}: ${err_msg}"
    else
        log_message "Deleted route ${prefix}"
    fi
}

# 新規/更新時。PDの払い出しはここで捕捉する。
leases6_committed() {
    if [ -n "${LEASES6_SIZE}" ] && [ "${LEASES6_SIZE}" -gt 0 ] 2>/dev/null; then
        local i=0 type_val addr_val plen_val
        while [ "$i" -lt "${LEASES6_SIZE}" ]; do
            eval "type_val=\"\${LEASES6_AT${i}_TYPE}\""
            if [ "${type_val}" = "IA_PD" ]; then
                eval "addr_val=\"\${LEASES6_AT${i}_ADDRESS}\""
                eval "plen_val=\"\${LEASES6_AT${i}_PREFIX_LEN}\""
                add_route "${addr_val}/${plen_val}" "${QUERY6_REMOTE_ADDR}" "${QUERY6_IFACE_NAME}"
            fi
            i=$((i + 1))
        done
    fi

    if [ -n "${DELETED_LEASES6_SIZE}" ] && [ "${DELETED_LEASES6_SIZE}" -gt 0 ] 2>/dev/null; then
        local i=0 type_val addr_val plen_val
        while [ "$i" -lt "${DELETED_LEASES6_SIZE}" ]; do
            eval "type_val=\"\${DELETED_LEASES6_AT${i}_TYPE}\""
            if [ "${type_val}" = "IA_PD" ]; then
                eval "addr_val=\"\${DELETED_LEASES6_AT${i}_ADDRESS}\""
                eval "plen_val=\"\${DELETED_LEASES6_AT${i}_PREFIX_LEN}\""
                del_route "${addr_val}/${plen_val}"
            fi
            i=$((i + 1))
        done
    fi
    exit 0
}

lease6_release() {
    if [ "${LEASE6_TYPE}" = "IA_PD" ]; then
        del_route "${LEASE6_ADDRESS}/${LEASE6_PREFIX_LEN}"
    fi
    exit 0
}

lease6_expire() {
    if [ "${LEASE6_TYPE}" = "IA_PD" ]; then
        del_route "${LEASE6_ADDRESS}/${LEASE6_PREFIX_LEN}"
    fi
    exit 0
}

unknown_handle() {
    log_message "Unhandled hook point: ${*}"
    exit 0
}

case "$1" in
    "leases6_committed") leases6_committed ;;
    "lease6_release")    lease6_release ;;
    "lease6_expire")     lease6_expire ;;
    *)                   unknown_handle "${@}" ;;
esac
