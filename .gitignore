# ==============================================================================
# ホワイトリスト方式 .gitignore
# 全ファイルを原則無視し、トラック対象のファイル・拡張子のみを明示的に指定します。
# これにより、新しいファイルや一時ファイルを作成しても勝手に Git に登録されません。
# ==============================================================================

# 1. すべてのファイルを原則無視
*

# 2. ディレクトリの走査を許可（配下のホワイトリストファイルを検出するため）
!*/

# 3. 走査自体を完全にスキップするディレクトリ（巨大・生成物・外部リポジトリ）
bearded-theme/
tools/node_modules/
web-dashboard/__pycache__/
web-dashboard/data/
bind/dynamic/
pppoe/srv-*/

# ==============================================================================
# トラック対象ファイル (ホワイトリスト)
# ==============================================================================

# --- Git / プロジェクト基本ファイル ---
!.gitignore
!Makefile
!*.md
!verify_calc.py

# --- 設定ファイルおよびテンプレート (ルート直下) ---
!ddns.conf.tmpl
!map-e.conf.tmpl
!map-e-static-ip.conf.tmpl
!pppoe.conf.tmpl

# --- ディレクトリ維持用 ---
!.gitkeep

# --- CE-setting (ルータ設定サンプル) ---
!CE-setting/
!CE-setting/*.txt

# --- bind (DNS) ---
!bind/*.tmpl

# --- chrony (NTP) ---
!chrony/Dockerfile
!chrony/chrony.conf.tmpl
!chrony/entrypoint.sh

# --- generator (Perl スクリプト / モジュール) ---
!generator/*.pl
!generator/*.pm
!generator/validate_option94.py

# --- kea-dhcp6 (DHCPv6) ---
!kea-dhcp6/*.tmpl

# --- mape-provisioning-server ---
!mape-provisioning-server/Dockerfile
!mape-provisioning-server/*.tmpl

# --- nat ---
!nat/Dockerfile
!nat/entrypoint.sh

# --- playwright (E2Eテスト) ---
!playwright/README.md

# --- pppoe ---
!pppoe/Dockerfile
!pppoe/entrypoint.sh
!pppoe/ip-down
!pppoe/ip-up

# --- radvd (RA) ---
!radvd/Dockerfile
!radvd/entrypoint.sh

# --- syslog-ng ---
!syslog-ng/Dockerfile
!syslog-ng/entrypoint.sh
!syslog-ng/logrotate.conf
!syslog-ng/syslog-ng.conf

# --- tools ---
!tools/package.json
!tools/*.mjs

# --- web-dashboard ---
!web-dashboard/Dockerfile
!web-dashboard/*.py
!web-dashboard/static/*.html
!web-dashboard/static/css/*.css
!web-dashboard/static/js/*.js
